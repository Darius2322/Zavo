# Copy this file to .env and fill in your own project's values.
# Find these in Supabase Dashboard -> Project Settings -> API.
# VITE_SUPABASE_ANON_KEY is the public "anon" key — safe for the browser.
# NEVER put the service_role key in this file or anywhere in src/.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
